# Optional development overrides only.
# OpenAI credentials are configured in the app and stored in Android SecureStore.

# Override the BLE advertised-name filter when needed during development.
EXPO_PUBLIC_LOOI_ROBOT_NAME=LOOI

# Development/debug toggles. Leave disabled for normal builds.
EXPO_PUBLIC_LOOI_DISABLE_ROBOT_AUTOCONNECT=0
EXPO_PUBLIC_LOOI_DISABLE_WAKEWORD_AUTOSTART=0
EXPO_PUBLIC_LOOI_ENABLE_EMULATOR_WAKEWORD=0

# Shared local speech-model worker count.
EXPO_PUBLIC_SHERPA_NUM_THREADS=2

# Dev builds only: mirror every diagnostic event to the JS console so it appears
# in `adb logcat` as ReactNativeJS (same redaction as the diagnostics export).
EXPO_PUBLIC_LOOI_DIAGNOSTIC_LOGCAT=0
